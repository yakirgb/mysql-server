--source include/have_innodb_min_8k.inc
--source include/not_windows.inc

--echo #
--echo # TRUNCATE TABLE
--echo #
--echo # Truncating is disallowed for parent tables unless such table
--echo # participates in self-referencing foreign keys only.
--echo #
CREATE TABLE t1 (pk INT PRIMARY KEY) ENGINE=INNODB;
CREATE TABLE t2 (fk INT NOT NULL, FOREIGN KEY (fk) REFERENCES t1 (pk)) ENGINE=INNODB;
--error ER_TRUNCATE_ILLEGAL_FK
TRUNCATE TABLE t1;
--echo # Truncation of child should succeed.
TRUNCATE TABLE t2;
DROP TABLE t2;
DROP TABLE t1;
CREATE TABLE t1 (pk INT PRIMARY KEY, fk INT,
                 FOREIGN KEY (fk) REFERENCES t1 (pk)) ENGINE=INNODB;
--echo # Truncation of self-referencing table should succeed.
TRUNCATE TABLE t1;
DROP TABLE t1;

--echo #
--echo # Also, truncating such tables is allowed if foreign key
--echo # checks are disabled.
--echo #

SET @old_foreign_key_checks = @@SESSION.foreign_key_checks;
CREATE TABLE t1 (pk INT PRIMARY KEY) ENGINE=INNODB;
CREATE TABLE t2 (fk INT NOT NULL, FOREIGN KEY (fk) REFERENCES t1 (pk)) ENGINE=INNODB;
CREATE TABLE t3 (pk INT PRIMARY KEY, fk INT,
                 FOREIGN KEY (fk) REFERENCES t1 (pk)) ENGINE=INNODB;
SET @@SESSION.foreign_key_checks = 0;
TRUNCATE TABLE t1;
TRUNCATE TABLE t2;
TRUNCATE TABLE t3;
SET @@SESSION.foreign_key_checks = 1;
--error ER_TRUNCATE_ILLEGAL_FK
TRUNCATE TABLE t1;
TRUNCATE TABLE t2;
TRUNCATE TABLE t3;
LOCK TABLES t1 WRITE;
SET @@SESSION.foreign_key_checks = 0;
TRUNCATE TABLE t1;
SET @@SESSION.foreign_key_checks = 1;
--error ER_TRUNCATE_ILLEGAL_FK
TRUNCATE TABLE t1;
UNLOCK TABLES;
DROP TABLE t3,t2,t1;
SET @@SESSION.foreign_key_checks = @old_foreign_key_checks;

--echo #
--echo # Test that TRUNCATE resets auto-increment.
--echo #

CREATE TABLE t1 (a INT PRIMARY KEY NOT NULL AUTO_INCREMENT);
INSERT INTO t1 VALUES (NULL), (NULL);
ANALYZE TABLE t1;
SELECT AUTO_INCREMENT FROM INFORMATION_SCHEMA.TABLES WHERE table_name = 't1';
SELECT * FROM t1 ORDER BY a;
TRUNCATE TABLE t1;
ANALYZE TABLE t1;
SELECT AUTO_INCREMENT FROM INFORMATION_SCHEMA.TABLES WHERE table_name = 't1';
INSERT INTO t1 VALUES (NULL), (NULL);
SELECT * FROM t1 ORDER BY a;
DROP TABLE t1;

--echo #
--echo # Test that TRUNCATE with innodb_default_row_format changed
--echo #

CREATE TEMPORARY TABLE t1(c1 DOUBLE(1,0)ZEROFILL,c2 BLOB,c3 YEAR)
ENGINE=InnoDB;
ALTER TABLE t1 MODIFY c2 VARCHAR(1024)BINARY CHARACTER SET 'Binary' COLLATE
'Binary';
ALTER TABLE t1 ADD INDEX(c2),ADD UNIQUE (c2);
SET @@GLOBAL.innodb_default_row_format=1;
TRUNCATE t1;
DROP TABLE t1;

SET @@GLOBAL.innodb_default_row_format=default;
CREATE  TABLE t1(c1 DOUBLE(1,0)ZEROFILL,c2 BLOB,c3 YEAR)
ENGINE=InnoDB;
ALTER TABLE t1 MODIFY c2 VARCHAR(1024)BINARY CHARACTER SET 'Binary' COLLATE
'Binary';
ALTER TABLE t1 ADD INDEX(c2),ADD UNIQUE (c2);

alter table t1 partition by key (c2) partitions 2;
SET @@GLOBAL.innodb_default_row_format=1;
TRUNCATE t1;
DROP TABLE t1;
SET @@GLOBAL.innodb_default_row_format=default;

--echo #
--echo # Bug#120156 TRUNCATE TABLE crashes when the database directory is a symlink
--echo #
--echo # The startup scan follows symlinks (via stat()), so when the database
--echo # directory is replaced by a symlink to external storage,
--echo # fil_tablespace_path_equals() detects MOVED_PREV (old_dir == new_dir via
--echo # realpath, both outside the default datadir, DD missing DATA_DIR flag) and
--echo # sets DICT_TF_MASK_DATA_DIR on the table. dict_save_data_dir_path() then
--echo # left data_dir_path=null (strcmp compared symlink paths, which are equal),
--echo # causing ut_a(strlen(m_remote_path) != 0) to abort inside create_table_def().
--echo #

LET $MYSQLD_DATADIR = `SELECT @@datadir`;
# The external directory MUST be named "bug120156db" (matching the schema) so
# that is_valid_location_within_db() accepts the resolved path -- it checks
# that the last component of the directory matches the schema name.
LET $EXTERNAL_DIR = $MYSQL_TMP_DIR/bug120156db;

CREATE DATABASE bug120156db;
CREATE TABLE bug120156db.t1 (id INT PRIMARY KEY, val VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO bug120156db.t1 VALUES (1,'hello'),(2,'world');

--source include/shutdown_mysqld.inc

--mkdir $EXTERNAL_DIR
--exec cp -a $MYSQLD_DATADIR/bug120156db/. $EXTERNAL_DIR/
--force-rmdir $MYSQLD_DATADIR/bug120156db
--exec ln -s $EXTERNAL_DIR $MYSQLD_DATADIR/bug120156db

# Plain restart: the datadir scanner follows the symlink (stat() resolves it),
# finds t1.ibd via the symlink path, realpath() resolves to the external dir,
# is_valid_location_within_db() accepts it (db_dir="bug120156db" matches schema),
# old_dir==new_dir but outside the datadir => MOVED_PREV fires and DATA_DIR is
# set in the DD without needing --innodb-directories.
--source include/start_mysqld.inc

--echo # FLAG 97 = 33 (base) | 64 (DATA_DIR bit) -- confirms MOVED_PREV fired
SELECT FLAG FROM information_schema.innodb_tables WHERE NAME='bug120156db/t1';

--echo # TRUNCATE must succeed (crashed before this fix)
# Suppress DATA DIRECTORY warnings: after recreating the table, InnoDB notes
# that $EXTERNAL_DIR is not in --innodb-directories and moves the file to the
# default location -- expected, and irrelevant to the crash being tested.
--disable_warnings
TRUNCATE TABLE bug120156db.t1;
--enable_warnings

INSERT INTO bug120156db.t1 VALUES (1,'after'),(2,'truncate');
SELECT * FROM bug120156db.t1 ORDER BY id;

DROP DATABASE bug120156db;
# DROP DATABASE removes the symlink and the (now-empty) target dir via symlink
# following; rm -rf is a no-op if the directory is already gone.
--exec rm -rf $EXTERNAL_DIR
